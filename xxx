import sqlite3

def validar_usuario_existe(tarjeta):
    conn = sqlite3.connect('usuarios_activos.db')
    cursor = conn.cursor()
    
    # Consultar si el usuario con el número de tarjeta existe
    cursor.execute('''
        SELECT * FROM usuarios WHERE tarjeta = ?
    ''', (tarjeta,))
    
    # Obtener el resultado
    usuario = cursor.fetchone()
    
    conn.close()
    
    return usuario  # Retorna el usuario si existe, o None si no existe
