import sqlite3

def ver_estructura_lotes():
    conn = sqlite3.connect("proveedores.db")
    cursor = conn.cursor()
    
    # Verifica la estructura de la tabla 
    cursor.execute("PRAGMA table_info(proveedores)")
    columnas = cursor.fetchall()
    for col in columnas:
        print(col)
    
    conn.close()

# Ver la estructura de la tabla 'lotes'
ver_estructura_lotes()
